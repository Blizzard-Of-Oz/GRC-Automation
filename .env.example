# App
APP_NAME=grc-automation-platform
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=grc_user
POSTGRES_PASSWORD=grc_password
POSTGRES_DB=grc_automation
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://grc_user:grc_password@postgres:5432/grc_automation

# Optional background worker toggles (future use)
ENABLE_JOBS=false
